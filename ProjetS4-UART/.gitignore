# ====================================================================
# 1. FICHIERS TEMPORAIRES GLOBAUX & SYSTEME
# ====================================================================
.DS_Store
Thumbs.db
Desktop.ini
*~
*.bak
*.swp

# ====================================================================
# 2. VIVADO (Généré par create_project.tcl)
# ====================================================================
# Journaux et logs de commandes Vivado
*.log
*.jou
*.str
*.mif
*.bda

# Dossiers de travail et de compilation Vivado
.Xil/
*.cache/
*.hw/
*.ip_user_files/
*.runs/
*.sim/
*.gen/

# Fichiers de projet et layouts d'interface utilisateur (générés au build)
*.xpr
*/ui/*.ui

# Fichiers d'implémentation et de programmation hardware (Bitstream)
*.bit
*.ltx

# ====================================================================
# 3. VITIS UNIFIED IDE (Workspace, Plateforme & Composants)
# ====================================================================
# Dossiers de métadonnées et de configuration locale de Vitis
.lock
.wsdata/
.clangd/
_ide/
logs/

# Bloquer les fichiers de configuration de composants contenant des chemins absolus
vitis-comp.json
app.yaml

# Fichiers de base de données internes de composants et indexations Vitis
.vitis/
*.vitis
node_modules/

# Plateforme et BSP (Entièrement régénérés par le script)
platform_main/
*_bsp/

# Fichier d'export Hardware (XSA) à la racine
/*.xsa

# ====================================================================
# 4. ARTEFACTS DE COMPILATION (CMake, Ninja, GCC)
# ====================================================================
# Dossiers de build globaux et locaux
build/
**/build/
CMakeFiles/
**/CMakeFiles/

# Fichiers de configuration et caches CMake / Ninja
CMakeCache.txt
cmake_install.cmake
build.ninja
*.ninja_deps
*.ninja_log
compile_commands.json
install_manifest.txt

# Scripts de compilation générés automatiquement pour l'application
hello_world/src/CMakeLists.txt
hello_world/src/*.cmake

# Binaires, Objets compilés et Bibliothèques statiques
*.o
*.obj
*.a
*.out
*.elf
*.size

# ====================================================================
# 5. PROTECTION / EXCEPTIONS
# ====================================================================
# Éviter de bloquer les .gitignore internes s'ils contiennent des règles spécifiques
!**/src/**/.gitignore

vivado-library/*